# Template for backend/.env — this file IS committed, .env is NOT.
# Copy it:  cp .env.example .env    then fill in the real values.

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string.
# Atlas > your cluster > Connect > Drivers > Node.js, then:
#   - replace <password> with your database user's password
#   - add the database name (weeklog) between the "/" and the "?"
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/weeklog?retryWrites=true&w=majority

# Secret used to sign JWTs. Must be long and random — generate your own with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=generate-your-own-do-not-use-this-value
JWT_EXPIRES_IN=7d

# Origin of the React dev server, allowed through CORS with credentials.
CLIENT_URL=http://localhost:5173

# The test suite uses the same cluster but a separate database (weeklog_test),
# derived automatically from MONGO_URI. Nothing in your real database is touched.

# OpenAI API key for the AI chat assistant (optional feature).
# Create one at https://platform.openai.com/api-keys
# If this is left empty the assistant endpoint returns 503 and the rest of
# the app keeps working normally.
OPENAI_API_KEY=

# Model used by the assistant. gpt-4o-mini is cheap, has a 128k context
# window and supports tool calling.
OPENAI_MODEL=gpt-4o-mini
